# Copy this file to .env and fill in what you have. Nothing here is required
# to run the app locally - unset SMS/email just logs to the console instead
# of sending, so you can try the whole flow before paying for anything.

# ---- General ----
BUSINESS_NAME=Shelves to Drawers RVA
BUSINESS_PHONE=(804) 839-7984
PORT=3000
# Public URL customers will see in texts/emails/QR code. Set this to your real
# domain once deployed (e.g. https://crm.shelvestodrawersrva.com).
BASE_URL=http://localhost:3000

# ---- Dashboard login (Basic Auth) ----
# Leave DASHBOARD_PASSWORD unset for local testing only. Set it before this is
# reachable on the public internet.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ---- Texting (Twilio) ----
# Sign up at twilio.com, buy a phone number (~$1.15/mo), grab these from the
# console. Until these are set, "texts" just print to the server console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Email (Resend) ----
# Sign up at resend.com (free tier available), verify a sending domain,
# create an API key. Until these are set, "emails" just print to the console.
RESEND_API_KEY=
EMAIL_FROM=Shelves to Drawers RVA <hello@yourdomain.com>

# ---- Self-serve booking availability ----
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
# 0=Sun 1=Mon 2=Tue 3=Wed 4=Thu 5=Fri 6=Sat
BUSINESS_DAYS=1,2,3,4,5
SLOT_MINUTES=60
BOOKING_WINDOW_DAYS=14
# Don't offer a day sooner than this many days out, and don't show more than
# this many day-options per calendar week (keeps the picker from looking wide-open).
BOOKING_MIN_LEAD_DAYS=4
BOOKING_MAX_DAYS_PER_WEEK=3

# ---- Appointment reminders ----
REMINDER_HOURS_BEFORE=24
REMINDER_CHECK_INTERVAL_MIN=15

# ---- Office Manager Assistant (BETA) ----
# Chat box on every dashboard page - type a plain-language instruction, it
# looks up/changes customers, leads, appointments, payments, and expenses.
# Get a key at console.anthropic.com. Until set, the assistant just replies
# that it isn't configured yet - nothing else breaks.
ANTHROPIC_API_KEY=
# Only change this if Anthropic renames/retires the default model - check
# docs.claude.com/en/docs/about-claude/models for current model IDs.
ANTHROPIC_MODEL=claude-sonnet-5
